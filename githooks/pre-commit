#!/usr/bin/env bash
# Committed pre-commit hook for the kb (shared brain) repo.
#
# Enable once per clone (the hook is versioned, not auto-installed):
#   git config core.hooksPath githooks
#
# It runs the full kb lint — required frontmatter, name==filename, type-token
# filename prefix, wikilink resolution, MEMORY.md index coverage, AND the
# public-repo secret/PII scan (AGENTS.md §3) — and blocks the commit on any
# failure. If a legitimate change is blocked by the secret scan, adjust the
# patterns in scripts/lint.sh (and .gitleaks.toml) — but think hard first.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KB_DIR="$DIR" bash "$DIR/scripts/lint.sh"
